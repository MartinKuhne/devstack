<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DevStack.Api\DevStack.Api.csproj" />
    <ProjectReference Include="..\DevStack.Domain\DevStack.Domain.csproj" />
    <ProjectReference Include="..\DevStack.Application\DevStack.Application.csproj" />
    <ProjectReference Include="..\DevStack.Infrastructure\DevStack.Infrastructure.csproj" />
    <ProjectReference Include="..\DevStack.Persistence\DevStack.Persistence.csproj" />
    <ProjectReference Include="..\DevStack.Mcp\DevStack.Mcp.csproj" />
    <ProjectReference Include="..\DevStack.OpenCode\DevStack.OpenCode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

</Project>
