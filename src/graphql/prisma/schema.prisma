generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DeliverableType {
  FEATURE
  DEFECT
  MAINTENANCE
  SPIKE
}

enum DeliverableStatus {
  DRAFT
  PLANNING
  READY
  INPROGRESS
  CODECOMPLETE
  TESTING
  DONE
  FAILED
  REJECTED
  NEEDSREVIEW
}

enum AgentTaskStatus {
  READY
  INPROGRESS
  DONE
  FAILED
  REJECTED
  NEEDSREVIEW
}

model Project {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.Text
  repository  String   @db.VarChar(500)

  deliverables Deliverable[]
  agentTasks   AgentTask[]

  @@map("projects")
}

model Deliverable {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String          @db.Uuid
  type              DeliverableType
  title             String          @db.VarChar(200)
  status            DeliverableStatus @default(DRAFT)
  description       String?         @db.Text
  acceptanceCriteria String?        @db.Text
  executionPlan     String?         @db.Text
  agentFeedback     String?         @db.Text
  securityImpact    String?         @db.Text
  performanceImpact String?         @db.Text
  testPlan          String?         @db.Text
  deploymentPlan    String?         @db.Text
  blocking          String?         @db.Text

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentTasks AgentTask[]

  @@map("deliverables")
}

model AgentTask {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                String           @db.Uuid
  deliverableId            String           @db.Uuid
  title                    String           @db.VarChar(300)
  status                   AgentTaskStatus  @default(READY)
  description              String           @default("") @db.Text
  result                   String?          @db.Text
  errors                   String?          @db.Text
  commitHash               String?          @db.VarChar(64)
  complexityRating         Int              @default(1)
  dependsOnAgentTaskId     String?          @db.Uuid
  promptTokens             Int?
  completionTokens         Int?
  executionDurationInSeconds Int?
  agent                    String?          @db.VarChar(100)

  project               Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable           Deliverable   @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  dependsOn             AgentTask?    @relation("AgentTaskDependency", fields: [dependsOnAgentTaskId], references: [id])
  dependedBy            AgentTask[]   @relation("AgentTaskDependency")

  @@map("agent_tasks")
}

model LargeLanguageModel {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url            String   @db.VarChar(500)
  model          String   @db.VarChar(200)
  modelAlias     String?  @db.VarChar(100)
  apiKey         String   @db.VarChar(1000)
  cost           Int      @default(0)
  maxComplexity  Int
  maxConcurrency Int?     @default(1)

  @@map("large_language_models")
}
