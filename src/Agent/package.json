{
  "name": "@devstack/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/index.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@opencode-ai/sdk": "^1.18.11",
    "graphql": "^16.10.0",
    "graphql-request": "^7.4.0",
    "pino": "^10.3.1",
    "simple-git": "^3.36.0",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.2",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.5"
  }
}
