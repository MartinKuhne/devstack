{
  "name": "@devstack/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/index.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@octokit/rest": "^22.0.1",
    "@opencode-ai/sdk": "^1.19.5",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "pino": "^10.4.0",
    "simple-git": "^4.0.2",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
