{
    "name": "adminui",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "exports": {
        "./lib": "./src/lib/utils.ts"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "preview": "vite preview",
        "codegen": "graphql-codegen --config codegen.ts",
        "codegen:check": "graphql-codegen --config codegen.ts && git diff --exit-code src/generated/graphql.ts",
        "typecheck": "tsc -b",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report src/reports"
    },
    "dependencies": {
        "@apollo/client": "^4.3.5",
        "@hookform/resolvers": "^5.9.2",
        "@radix-ui/react-alert-dialog": "^1.2.1",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-progress": "^1.2.1",
        "@radix-ui/react-scroll-area": "^1.4.0",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slider": "^1.6.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-toast": "^1.3.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@tailwindcss/typography": "^0.5.20",
        "@types/dompurify": "^3.0.5",
        "cmdk": "^1.1.1",
        "dompurify": "^3.4.17",
        "graphql": "^16.14.2",
        "loglevel": "^1.9.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-markdown": "^10.1.0",
        "react-router": "^8.5.1",
        "react-textarea-autosize": "^8.5.9",
        "react-toastify": "^11.2.0",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "zod": "^4.6.7"
    },
    "overrides": {
        "postcss-selector-parser": "^6.1.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@graphql-codegen/cli": "^6.3.1",
        "@graphql-codegen/typescript": "^5.0.10",
        "@graphql-codegen/typescript-operations": "^5.1.0",
        "@graphql-codegen/typescript-react-apollo": "^4.4.2",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.58.2",
        "@typescript-eslint/parser": "^8.58.2",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/ui": "^4.1.12",
        "autoprefixer": "^10.6.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jsdom": "^29.1.1",
        "lucide-react": "^1.66.0",
        "msw": "^2.15.0",
        "postcss": "^8.5.32",
        "prettier": "^3.9.10",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^4.1.12"
    }
}
