erDiagram

    Project {
        string Name
        string Description
        string Repository
    }

    Deliverable {
        guid ProjectId
        string Title
        string Status "Draft | Planning | Ready | InProgress | CodeComplete | Testing | Done | Failed | Rejected | NeedsReview"
        string Type "Feature | Defect | Maintenance | Spike"
        string Description
        string AcceptanceCriteria "optional"
        string AgentFeedback "optional"
        string ExecutionPlan "optional"
        string SecurityImpact "optional"
        string PerformanceImpact "optional"
        string TestPlan "optional"
        string DeploymentPlan "optional"
        string Blocking "optional"
    }

    AgentTask {
        guid ProjectId
        guid DeliverableId
        string Title
        string Status "Ready | InProgress | Done | Failed | Rejected | NeedsReview"
        string Description
        string Result "optional"
        string Errors "optional"
        string CommitHash "optional"
        int ComplexityRating
        guid DependsOnAgentTaskId "optional"
        int PromptTokens "optional"
        int CompletionTokens "optional"
        int ExecutionDurationInSeconds "optional"
        string Agent "optional"
    }

    LargeLanguageModel {
        string Url
        
        string Model
        string ModelAlias "optional"
        string ApiKey "optional"
        int Cost "default 0"
        int MaxComplexity "default 10"
        int MaxConcurrency "default 1"
    }

    %% Relationships
    Project ||--o{ Deliverable : "has many"
    Deliverable ||--o{ AgentTask : "has many"
    